# Copy to .env and fill in. .env is never committed.
# Signs sign-in tokens. At least 32 characters; make a new one for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Creates the first admin the first time the server starts (remove ADMIN_PASSWORD afterwards).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set to 1 when the site is served over HTTPS.
COOKIE_SECURE=0
